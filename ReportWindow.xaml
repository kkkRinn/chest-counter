<Window x:Class="ChestCounter.ReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Match history" Width="640" Height="480" Background="#0A0E1A"
        WindowStartupLocation="CenterOwner" FontFamily="Segoe UI Variable Display, Segoe UI">
    <Window.Resources>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#111827"/>
            <Setter Property="Foreground" Value="#8693B0"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#E6EDF7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,6"/>
        </Style>
    </Window.Resources>
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                  GridLinesVisibility="None" Background="#0F1524" RowBackground="#0F1524"
                  AlternatingRowBackground="#121A2C" BorderBrush="#1F2A44" CanUserAddRows="False">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Played" Binding="{Binding PlayedAt, StringFormat=yyyy-MM-dd HH:mm}" Width="170"/>
                <DataGridTextColumn Header="Chests" Binding="{Binding Chests}" Width="80"/>
                <DataGridTextColumn Header="Replay" Binding="{Binding Id}" Width="*"/>
                <DataGridTextColumn Header="Note" Binding="{Binding Note}" Width="170"/>
            </DataGrid.Columns>
        </DataGrid>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Open data folder" Style="{StaticResource Pill}" Margin="0,0,8,0" Click="Folder_Click"/>
            <Button Content="Clear history" Style="{StaticResource Pill}" Click="Clear_Click"/>
        </StackPanel>
    </Grid>
</Window>
